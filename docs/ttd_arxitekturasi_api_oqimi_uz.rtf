\outl0\strokewidth0 \strokec3 cache va remote orasida tanlash,\
\ls3\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec3 bir nechta manbani birlashtirish,\
